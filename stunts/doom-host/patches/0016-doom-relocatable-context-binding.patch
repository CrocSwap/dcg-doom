Subject: [PATCH 0016] Bind Doom context to the current account mapping

Patch 0007 keeps its original fixed-address behavior reproducible. This
follow-on header variant is generated by mkctx.py --runtime-binding from the
same 0001-0006 source and makes the account pointer an instruction-local bind.
The static-resource v2 binding path rebases account-relative pointers before
rendering from the moved account mapping.

Applies on top of 0001-0015.

diff -ruN --exclude=CVS ctx-base/linuxdoom-1.10/headless/doom_ctx.h ctx-regen/headless/doom_ctx.h
--- a/linuxdoom-1.10/headless/doom_ctx.h
+++ b/linuxdoom-1.10/headless/doom_ctx.h
@@ -1,8 +1,7 @@
 /* Patch 0007: every mutable engine global lives in doom_ctx_t,
- * reached through the compile-time constant DOOM_CTX.  On the host
- * DOOM_CTX is a real backing (host allows statics); on SBF it is
- * the pinned context-account data address, guarded at instruction
- * entry (see doom_ctx_guard).  Generated by stunts/doom-host/tools/
+ * reached through DOOM_CTX.  On SBF doom_ctx_guard binds it
+ * to the current account mapping for relocation-aware calls.
+ * Generated by stunts/doom-host/tools/
  * mkctx.py: do not hand-edit. */
 #ifndef DOOM_CTX_H
 #define DOOM_CTX_H
@@ -468,11 +467,8 @@
 unsigned long doom_ctx_size(void);
 
 #ifdef DOOM_SBF_BUILD
-/* First account-data address at the pinned layout (M1021); the
- * instruction guard refuses any other mapping, so a future layout
- * change fails loudly instead of corrupting state. */
-#define DOOM_CTX_ADDR 0x400000060UL
-#define DOOM_CTX ((doom_ctx_t *)DOOM_CTX_ADDR)
+extern doom_ctx_t *doom_ctx_active;
+#define DOOM_CTX (doom_ctx_active)
 #else
 extern doom_ctx_t doom_ctx_host_backing;
 #define DOOM_CTX (&doom_ctx_host_backing)
