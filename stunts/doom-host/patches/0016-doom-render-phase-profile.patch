     // check for new console commands.
     NetUpdate ();
 
     // The head node is the last node output.
     R_RenderBSPNode ((DOOM_CTX->numnodes)-1);
+    R_DRAW_PHASE(1203);
     
     // Check for new console commands.
     NetUpdate ();
     
     R_DrawPlanes ();
+    R_DRAW_PHASE(1204);
     
     // Check for new console commands.
     NetUpdate ();
     
     R_DrawMasked ();
+    R_DRAW_PHASE(1205);
 
     // Check for new console commands.
-    NetUpdate ();				
-}
+    NetUpdate ();
+    R_DRAW_PHASE(1206);
+}
