--- a/linuxdoom-1.10/r_draw.h
+++ b/linuxdoom-1.10/r_draw.h
@@ -31,6 +31,23 @@
 
 
 // first pixel in a column
+
+
+/* Diagnostic-only render phase markers and drawer ablation.  A host build and
+ * a qualifying SBF image never define DOOM_SBF_PHASE_PROFILE, so the marker
+ * calls below compile out and the preprocessed output is unchanged.
+ * DOOM_SBF_RENDER_COUNT_ONLY keeps every BSP traversal, every column and span
+ * setup and every per-pixel texture computation but drops the framebuffer
+ * store, so the CU difference between a phase-profile image and a count-only
+ * image is the pixel-write cost of the drawers.  Both defines are
+ * diagnostic-only and must never appear in a deployable image. */
+#ifdef DOOM_SBF_PHASE_PROFILE
+extern void doom_sbf_phase_marker(unsigned long phase);
+#define R_DRAW_PHASE(phase) doom_sbf_phase_marker((unsigned long)(phase))
+#else
+#define R_DRAW_PHASE(phase) ((void)0)
+#endif
+
 
 
 // The span blitting interface.
