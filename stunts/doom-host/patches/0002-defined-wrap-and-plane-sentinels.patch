diff --git a/linuxdoom-1.10/doom_wrap.h b/linuxdoom-1.10/doom_wrap.h
new file mode 100644
index 00000000..5ded0cce
--- /dev/null
+++ b/linuxdoom-1.10/doom_wrap.h
@@ -0,0 +1,32 @@
+/* Explicit 32-bit two's-complement arithmetic for the retained Doom path.
+ * The 1997 sources assumed the host implementation's signed shifts and
+ * overflows wrapped.  Keep those bit patterns without asking C to perform
+ * undefined signed arithmetic. */
+#ifndef __DOOM_WRAP__
+#define __DOOM_WRAP__
+
+#include <stdint.h>
+
+static int32_t doom_i32_from_u32(uint32_t bits)
+{
+    if (bits <= INT32_MAX)
+        return (int32_t)bits;
+    return -1 - (int32_t)(UINT32_MAX - bits);
+}
+
+static int32_t doom_i32_lshift(int32_t value, unsigned shift)
+{
+    return doom_i32_from_u32((uint32_t)value << shift);
+}
+
+static int32_t doom_i32_add(int32_t left, int32_t right)
+{
+    return doom_i32_from_u32((uint32_t)left + (uint32_t)right);
+}
+
+static int32_t doom_i32_mul(int32_t left, int32_t right)
+{
+    return doom_i32_from_u32((uint32_t)left * (uint32_t)right);
+}
+
+#endif
