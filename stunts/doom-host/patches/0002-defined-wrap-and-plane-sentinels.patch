+/* External plane x coordinates are -1..SCREENWIDTH.  The named sentinels
+ * preserve the old adjacent-byte numeric behaviour without subobject OOB. */
+static byte *plane_top(visplane_t *pl, int x)
+{
+    if (x == -1) return &pl->pad1;
+    if (x == SCREENWIDTH) return &pl->pad2;
+    return &pl->top[x];
+}
+static byte *plane_bottom(visplane_t *pl, int x)
+{
+    if (x == -1) return &pl->pad3;
+    if (x == SCREENWIDTH) return &pl->pad4;
+    return &pl->bottom[x];
+}
+#define PL_TOP(pl, x) (*plane_top((pl), (x)))
+#define PL_BOTTOM(pl, x) (*plane_bottom((pl), (x)))
