+}
+
+
+//
+// Z_Census
+// Walks the block list and reports, for the current zone, the bytes held by
+// non-purgeable tags (the hard floor a fixed arena must cover), the bytes
+// held by purgeable cache, and the byte extent of the highest live block.
+// Read-only: it allocates nothing and frees nothing.
+//
+void Z_Census (int* fixed, int* purgeable, int* extent, int* zonesize)
+{
+    memblock_t*	block;
+    int		held_fixed = 0;
+    int		held_purge = 0;
+    int		high = 0;
+
+    for (block = mainzone->blocklist.next ;
+	 block != &mainzone->blocklist ;
+	 block = block->next)
+    {
+	if (!block->user)
+	    continue;
+	if (block->tag < PU_PURGELEVEL)
+	    held_fixed += block->size;
+	else
+	    held_purge += block->size;
+	high = (int)((byte *)block - (byte *)mainzone) + block->size;
+    }
+
+    if (fixed)
+	*fixed = held_fixed;
+    if (purgeable)
+	*purgeable = held_purge;
+    if (extent)
+	*extent = high;
+    if (zonesize)
+	*zonesize = mainzone->size;
 }
 
 
