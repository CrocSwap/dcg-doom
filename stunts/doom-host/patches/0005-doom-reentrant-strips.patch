+#ifndef DOOM_RENDER_H
+#define DOOM_RENDER_H
+#include <stddef.h>
+#include <stdint.h>
+#include "doom_account.h"
+#define DOOM_RENDER_STRIPS 8
+#define DOOM_RENDER_STRIP_WIDTH 40
+#define DOOM_RENDER_FRAME_BYTES (320 * 200)
+#define DOOM_RENDER_STRIP_PIXELS (DOOM_RENDER_STRIP_WIDTH * 200)
+#define DOOM_RENDER_STRIP_ACCOUNT_BYTES 8192
+#define DOOM_RENDER_STRIP_HEADER_BYTES 64
+#define DOOM_RENDER_SCRATCH_BYTES 131072
+#define DOOM_RENDER_SCRATCH_HEADER_BYTES 128
+#define DOOM_RENDER_SEED_OFFSET DOOM_RENDER_SCRATCH_HEADER_BYTES
+#define DOOM_RENDER_FRAME_OFFSET (DOOM_RENDER_SCRATCH_HEADER_BYTES + DOOM_RENDER_FRAME_BYTES)
+enum doom_render_refusal { DOOM_RENDER_OK=0, DOOM_RENDER_REFUSE_STRIP=1, DOOM_RENDER_REFUSE_SCRATCH=2, DOOM_RENDER_REFUSE_STATE=3, DOOM_RENDER_REFUSE_WAD=4 };
+typedef struct { uint64_t host_ticks; uint64_t wall_ns; unsigned drawsegs; unsigned vissprites; unsigned fuzz_columns; } doom_render_metrics_t;
+void DoomRenderScratchInit(uint8_t *, size_t, const doom_account_t *);
+int DoomRenderStrip(unsigned, const uint8_t *, size_t, const doom_account_t *, uint8_t *, size_t, uint8_t[DOOM_RENDER_STRIP_ACCOUNT_BYTES], doom_render_metrics_t *, uint32_t);
+extern unsigned doom_render_fuzz_columns;
+#endif
