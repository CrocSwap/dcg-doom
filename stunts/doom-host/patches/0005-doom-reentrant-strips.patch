+extern void R_RenderPlayerView(player_t *);
+extern int fuzzpos, prndindex, skytexture, framecount;
+unsigned doom_render_fuzz_columns;
+static uint64_t ht(void) {
+#ifdef __APPLE__
+    return mach_absolute_time();
+#else
+    struct timespec t; clock_gettime(CLOCK_MONOTONIC,&t); return (uint64_t)t.tv_sec*1000000000ULL+t.tv_nsec;
+#endif
+}
+static uint64_t ns(uint64_t t) {
+#ifdef __APPLE__
+    static mach_timebase_info_data_t tb; if(!tb.denom)mach_timebase_info(&tb); return t*(uint64_t)tb.numer/(uint64_t)tb.denom;
+#else
+    return t;
+#endif
+}
+static uint32_t g32(const uint8_t*p){return (uint32_t)p[0]|((uint32_t)p[1]<<8)|((uint32_t)p[2]<<16)|((uint32_t)p[3]<<24);}
+static void p32(uint8_t*p,uint32_t x){p[0]=(uint8_t)x;p[1]=(uint8_t)(x>>8);p[2]=(uint8_t)(x>>16);p[3]=(uint8_t)(x>>24);}
+static uint32_t stamp(const uint8_t*p,size_t n){uint32_t h=2166136261u;while(n--)h=(h^*p++)*16777619u;return h;}
+static void release_thinkers(void){thinker_t*t=thinkercap.next,*n;if(!t)return;while(t!=&thinkercap){n=t->next;Z_Free(t);t=n;}P_InitThinkers();}
+void DoomRenderScratchInit(uint8_t*s,size_t n,const doom_account_t*a){if(!s||n<DOOM_RENDER_SCRATCH_BYTES)return;memset(s,0,n);memcpy(s,"DOOM-RS1",8);p32(s+8,1);p32(s+12,DOOM_RENDER_SCRATCH_HEADER_BYTES);p32(s+16,DOOM_RENDER_SCRATCH_BYTES);p32(s+48,0xffffffffu);if(a)memcpy(s+20,DoomAccountWadHash(a),32);}
+static int DoomRenderStripLocal(unsigned id,const uint8_t*image,size_t bytes,const doom_account_t*a,uint8_t*s,size_t n,uint8_t out[DOOM_RENDER_STRIP_ACCOUNT_BYTES],doom_render_metrics_t*m,uint32_t expected){byte*old[5],*frame;uint64_t b,e;unsigned x,y;uint32_t z;if(id>=8)return DOOM_RENDER_REFUSE_STRIP;if(!s||n<DOOM_RENDER_SCRATCH_BYTES||!out)return DOOM_RENDER_REFUSE_SCRATCH;if(!a||!DoomAccountWadHash(a))return DOOM_RENDER_REFUSE_WAD;if(!image||bytes<24||memcmp(image,"DOOM-ST1",8)||g32(image+8)!=0||g32(image+20)!=expected)return DOOM_RENDER_REFUSE_STATE;z=stamp(image,bytes);if(g32(s+48)!=z){p32(s+72,(uint32_t)fuzzpos);p32(s+76,(uint32_t)validcount);p32(s+80,(uint32_t)rndindex);p32(s+84,(uint32_t)prndindex);p32(s+88,(uint32_t)skytexture);p32(s+92,(uint32_t)framecount);release_thinkers();if(DoomStateDecode(image,bytes))return DOOM_RENDER_REFUSE_STATE;p32(s+48,z);p32(s+52,(uint32_t)fuzzpos);p32(s+56,(uint32_t)validcount);p32(s+60,(uint32_t)rndindex);p32(s+64,(uint32_t)prndindex);p32(s+68,(uint32_t)skytexture);}fuzzpos=(int)g32(s+52);validcount=(int)g32(s+56);rndindex=(int)g32(s+60);prndindex=(int)g32(s+64);skytexture=(int)g32(s+68);validcount=(int)(0x40000000u+id*2u);frame=s+DOOM_RENDER_FRAME_OFFSET;memcpy(old,screens,sizeof(old));memcpy(frame,s+DOOM_RENDER_SEED_OFFSET,DOOM_RENDER_FRAME_BYTES);screens[0]=screens[1]=screens[2]=screens[3]=screens[4]=frame;R_ExecuteSetViewSize();doom_render_fuzz_columns=0;b=ht();R_RenderPlayerView(&players[displayplayer]);e=ht();memset(out,0,DOOM_RENDER_STRIP_ACCOUNT_BYTES);memcpy(out,"DOOM-STRIP1",8);p32(out+8,1);p32(out+12,64);p32(out+16,8192);p32(out+20,id);p32(out+24,expected);memcpy(out+28,DoomAccountWadHash(a),32);for(x=0;x<40;x++)for(y=0;y<200;y++)out[64+x*200+y]=frame[y*320+id*40+x];if(m){m->host_ticks=e-b;m->wall_ns=ns(e)-ns(b);m->drawsegs=(unsigned)(ds_p-drawsegs);m->vissprites=(unsigned)(vissprite_p-vissprites);m->fuzz_columns=doom_render_fuzz_columns;}memcpy(screens,old,sizeof(old));R_ExecuteSetViewSize();fuzzpos=(int)g32(s+72);validcount=(int)g32(s+76);rndindex=(int)g32(s+80);prndindex=(int)g32(s+84);skytexture=(int)g32(s+88);framecount=(int)g32(s+92);return DOOM_RENDER_OK;}
+typedef struct { int rc; uint8_t out[DOOM_RENDER_STRIP_ACCOUNT_BYTES]; doom_render_metrics_t metrics; } render_ipc_t;
+static int io_write(int fd,const void*p,size_t n){const uint8_t*b=p;ssize_t k;while(n){k=write(fd,b,n);if(k<=0)return -1;b+=k;n-=(size_t)k;}return 0;}
+static int io_read(int fd,void*p,size_t n){uint8_t*b=p;ssize_t k;while(n){k=read(fd,b,n);if(k<=0)return -1;b+=k;n-=(size_t)k;}return 0;}
+int DoomRenderStrip(unsigned id,const uint8_t*image,size_t bytes,const doom_account_t*a,uint8_t*s,size_t n,uint8_t out[DOOM_RENDER_STRIP_ACCOUNT_BYTES],doom_render_metrics_t*m,uint32_t expected){int f[2],status;pid_t pid;render_ipc_t p;if(id>=8)return DOOM_RENDER_REFUSE_STRIP;if(!s||n<DOOM_RENDER_SCRATCH_BYTES||!out)return DOOM_RENDER_REFUSE_SCRATCH;memcpy(s+DOOM_RENDER_SEED_OFFSET,screens[0],DOOM_RENDER_FRAME_BYTES);if(pipe(f)<0)return DOOM_RENDER_REFUSE_SCRATCH;pid=fork();if(pid<0){close(f[0]);close(f[1]);return DOOM_RENDER_REFUSE_SCRATCH;}if(pid==0){memset(&p,0,sizeof(p));p.rc=DoomRenderStripLocal(id,image,bytes,a,s,n,p.out,&p.metrics,expected);close(f[0]);io_write(f[1],&p,sizeof(p));close(f[1]);_exit(0);}close(f[1]);if(io_read(f[0],&p,sizeof(p))<0){close(f[0]);waitpid(pid,&status,0);return DOOM_RENDER_REFUSE_SCRATCH;}close(f[0]);waitpid(pid,&status,0);if(!WIFEXITED(status)||WEXITSTATUS(status)!=0)return DOOM_RENDER_REFUSE_SCRATCH;memcpy(out,p.out,sizeof(p.out));if(m)*m=p.metrics;return p.rc;}
