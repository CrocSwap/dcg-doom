+
+/* Pure screen-position fuzz phase.  Vanilla Doom advances the file-static
+ * fuzzpos once per fuzz pixel in draw order, so the phase of a pixel depends
+ * on how many fuzz pixels earlier columns of the same frame drew.  A strip
+ * render is a separate transaction that walks the scene again, so that count
+ * is not reproducible across strips and the in-strip columns come out with a
+ * shifted phase.  Deriving the table index from the pixel's own screen
+ * position removes the cross-strip dependency without carrying the phase in
+ * the snapshot: the native frame and every strip read the same index for the
+ * same (column, row).  The neighbourhood is still the pixel one row above or
+ * below in the same column, so the result is still Doom's vertical shimmer,
+ * and the index is decorrelated between neighbouring rows and columns.  This
+ * is a rendering-behaviour change: the frame a shadow sprite appears in
+ * differs from vanilla, so the native oracle and the strips are both built
+ * from this patched source. */
+static int doom_fuzz_index (int x, int y)
+{
+    unsigned h = (unsigned)x * 0x9e3779b1u + (unsigned)y * 0x85ebca6bu;
 
+    h ^= h >> 15;
+    return (int)(h % FUZZTABLE);
+}
 
 
