+/* LIF/2 staged level setup.  Each phase re-derives the map lump from the
+ * committed image state so no process-local continuation is required. */
+static int P_RI2MapLump(int episode, int map, char lumpname[9])
+{
+    if (gamemode == commercial)
+    {
+        if (map < 10) sprintf(lumpname, "map0%i", map);
+        else sprintf(lumpname, "map%i", map);
+    }
+    else
+    {
+        lumpname[0] = 'E';
+        lumpname[1] = '0' + episode;
+        lumpname[2] = 'M';
+        lumpname[3] = '0' + map;
+        lumpname[4] = 0;
+    }
+    return W_GetNumForName(lumpname);
+}
+
+void P_SetupLevelRI2Phase(unsigned int phase, int episode, int map,
+                          int playermask, skill_t skill)
+{
+    int lumpnum;
+    char lumpname[9];
+    int i;
+
+    switch (phase)
+    {
+    case 0:
+        totalkills = totalitems = totalsecret = wminfo.maxfrags = 0;
+        wminfo.partime = 180;
+        for (i = 0; i < MAXPLAYERS; i++)
+            players[i].killcount = players[i].secretcount = players[i].itemcount = 0;
+        players[(DOOM_CTX->consoleplayer)].viewz_m = 1;
+        S_Start();
+        Z_FreeTags(PU_LEVEL, PU_PURGELEVEL - 1);
+        P_InitThinkers();
+        W_Reload();
+        leveltime = 0;
+        break;
+    case 1:
+        lumpnum = P_RI2MapLump(episode, map, lumpname);
+        P_LoadBlockMap(lumpnum + ML_BLOCKMAP);
+        break;
+    case 2:
+        lumpnum = P_RI2MapLump(episode, map, lumpname);
+        P_LoadVertexes(lumpnum + ML_VERTEXES);
+        break;
+    case 3:
+        lumpnum = P_RI2MapLump(episode, map, lumpname);
+        P_LoadSectors(lumpnum + ML_SECTORS);
+        break;
+    case 4:
+        lumpnum = P_RI2MapLump(episode, map, lumpname);
+        P_LoadSideDefs(lumpnum + ML_SIDEDEFS);
+        break;
+    case 5:
+        lumpnum = P_RI2MapLump(episode, map, lumpname);
+        P_LoadLineDefs(lumpnum + ML_LINEDEFS);
+        break;
+    case 6:
+        lumpnum = P_RI2MapLump(episode, map, lumpname);
+        P_LoadSubsectors(lumpnum + ML_SSECTORS);
+        break;
+    case 7:
+        lumpnum = P_RI2MapLump(episode, map, lumpname);
+        P_LoadNodes(lumpnum + ML_NODES);
+        break;
+    case 8:
+        lumpnum = P_RI2MapLump(episode, map, lumpname);
+        P_LoadSegs(lumpnum + ML_SEGS);
+        break;
+    case 9:
+        lumpnum = P_RI2MapLump(episode, map, lumpname);
+        rejectmatrix = W_CacheLumpNum(lumpnum + ML_REJECT, PU_LEVEL);
+        P_GroupLines();
+        break;
+    case 10:
+        lumpnum = P_RI2MapLump(episode, map, lumpname);
+        bodyqueslot = 0;
+        deathmatch_p = deathmatchstarts;
+        P_LoadThings(lumpnum + ML_THINGS);
+        if (DOOM_CTX->deathmatch)
+            for (i = 0; i < MAXPLAYERS; i++)
+                if (playeringame[i])
+                {
+                    players[i].mo = NULL;
+                    G_DeathMatchSpawnPlayer(i);
+                }
+        break;
+    case 11:
+        iquehead = iquetail = 0;
+        P_SpawnSpecials();
+        break;
+    case 12:
+        if (precache) R_PrecacheLevel();
+        break;
+    default:
+        break;
+    }
+    (void)playermask;
+    (void)skill;
+}
