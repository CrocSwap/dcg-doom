+void G_DoLoadLevelRI2Phase(unsigned int phase)
+{
+    int i;
+    switch (phase)
+    {
+    case 1:
+        skyflatnum = R_FlatNumForName(SKYFLATNAME);
+        if (gamemode == commercial || gamemode == pack_tnt || gamemode == pack_plut)
+        {
+            skytexture = R_TextureNumForName("SKY3");
+            if (gamemap < 12) skytexture = R_TextureNumForName("SKY1");
+            else if (gamemap < 21) skytexture = R_TextureNumForName("SKY2");
+        }
+        levelstarttic = gametic;
+        if (wipegamestate == GS_LEVEL) wipegamestate = -1;
+        gamestate = GS_LEVEL;
+        for (i = 0; i < MAXPLAYERS; i++)
+        {
+            if (playeringame[i] && players[i].playerstate == PST_DEAD)
+                players[i].playerstate = PST_REBORN;
+            memset(players[i].frags, 0, sizeof(players[i].frags));
+        }
+        break;
+    case 15:
+        displayplayer = DOOM_CTX->consoleplayer;
+        starttime = I_GetTime();
+        gameaction = ga_nothing;
+        Z_CheckHeap();
+        memset(gamekeydown, 0, sizeof(gamekeydown));
+        joyxmove = joyymove = 0;
+        mousex = mousey = 0;
+        sendpause = sendsave = paused = false;
+        memset(mousebuttons, 0, sizeof(mousebuttons));
+        memset(joybuttons, 0, sizeof(joybuttons));
+        break;
+    default:
+        if (phase >= 2 && phase <= 14)
+            P_SetupLevelRI2Phase(phase - 2, gameepisode, gamemap, 0, gameskill);
+        break;
+    }
+}
