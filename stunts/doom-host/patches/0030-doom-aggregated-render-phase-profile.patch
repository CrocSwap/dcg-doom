@@ -943,8 +948,11 @@
     vissprite_t*	spr;
     drawseg_t*		ds;
 	
+    PROF_ENTER(DOOM_SBF_PROF_SORT_VISSPR, 2);
     R_SortVisSprites ();
     R_DRAW_PHASE(1210);
+    PROF_EXIT(DOOM_SBF_PROF_SORT_VISSPR, 2);
+    PROF_ENTER(DOOM_SBF_PROF_VISSPRITES, 2);
 
     if (vissprite_p > vissprites)
