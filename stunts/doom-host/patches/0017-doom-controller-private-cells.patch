     *cursor += 4;
     apply_command(cmd);
-    controller_v2_armed = 0;
+    controller_state = DOOM_CONTROLLER_IDLE;
+    controller_applied = 1;
     return 1;
 #endif
 }
--- a/linuxdoom-1.10/headless/doom_controller.h
+++ b/linuxdoom-1.10/headless/doom_controller.h
@@ -8,6 +8,13 @@
 /* DOOM-CI1 v1: the four bytes are the captured ticcmd at byte 24. */
 #define DOOM_CONTROLLER_BYTES 64
 
+/* DOOM-CI3 v1: one armed command per tic, so a tic has one unambiguous
+ * ingress.  The SBF build keeps these cells in the context account; see
+ * doom_ctx.h's DOOM_SBF_PRIVATE_BYTES region. */
+#define DOOM_CONTROLLER_IDLE 0
+#define DOOM_CONTROLLER_ARMED_V1 1
+#define DOOM_CONTROLLER_ARMED_V2 2
+
 int DoomControllerRead(const char *, uint32_t, uint8_t[4]);
 
 /* DOOM-CI2 v1 is an explicit one-shot runtime ingress. Its four command
@@ -24,4 +31,11 @@
 int DoomControllerArmV2(const uint8_t[4]);
 int DoomControllerApplyTiccmdV2(ticcmd_t *, uint8_t **);
 
+/* DOOM-CI3 v1: arming a command clears the applied receipt, applying one sets
+ * it, and DoomControllerConsumed reads and clears it.  A caller that requires
+ * every G_Ticker to have consumed a command it armed reads the receipt after
+ * the ticker and refuses the tic when it is zero, instead of letting a tic run
+ * on whatever the engine already held. */
+int DoomControllerConsumed(void);
+
 #endif
