     if (!cmd || !cursor || !*cursor) {
-        controller_v2_armed = 0;
+        controller_state = DOOM_CONTROLLER_IDLE;
         return -1;
     }
     /* Continue accepting committed SIM/2 commands after DEMO1 ends. Keep
@@ -117,17 +130,19 @@
     if (!DoomControllerValidateCapturedDemoCursor(*cursor))
         *cursor += 4;
     apply_command(cmd);
-    controller_v2_armed = 0;
+    controller_state = DOOM_CONTROLLER_IDLE;
+    controller_applied = 1;
     return 1;
 #else
     if (!cmd || !cursor || !*cursor
         || DoomControllerValidateCapturedDemoCursor(*cursor)) {
-        controller_v2_armed = 0;
+        controller_state = DOOM_CONTROLLER_IDLE;
         return -1;
