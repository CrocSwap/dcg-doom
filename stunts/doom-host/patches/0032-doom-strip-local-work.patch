@@ -372,7 +372,17 @@ void R_DrawPlanes (void)
     int			x;
     int			stop;
     int			angle;
+    int			draw_start;
+    int			draw_stop;
+    int			clip_left;
+    int			clip_right;
+    int			y;
+    int			clip_mode;
 				
+    clip_mode = (doom_render_fuzz_columns >> 30) & 3u;
+    clip_left = (int)(((doom_render_fuzz_columns >> 27) & 7u) * 40u);
+    clip_right = clip_left + 40;
+
 #ifdef RANGECHECK
     if (ds_p - drawsegs > MAXDRAWSEGS)
 	I_Error ("R_DrawPlanes: drawsegs overflow (%i)",
@@ -392,6 +402,9 @@ void R_DrawPlanes (void)
 	if (pl->minx > pl->maxx)
 	    continue;
 
+	if (clip_mode && (pl->maxx < clip_left || pl->minx >= clip_right))
+	    continue;
+
 	
 	// sky flat
 	if (pl->picnum == skyflatnum)
@@ -404,7 +417,14 @@ void R_DrawPlanes (void)
 	    //  by INVUL inverse mapping.
 	    dc_colormap = colormaps;
 	    dc_texturemid = skytexturemid;
-	    for (x=pl->minx ; x <= pl->maxx ; x++)
+	    draw_start = pl->minx;
+	    draw_stop = pl->maxx;
+	    if (clip_mode)
+	    {
+		if (draw_start < clip_left) draw_start = clip_left;
+		if (draw_stop >= clip_right) draw_stop = clip_right - 1;
+	    }
+	    for (x=draw_start ; x <= draw_stop ; x++)
 	    {
 		dc_yl = PL_TOP(pl,x);
 		dc_yh = PL_BOTTOM(pl,x);
@@ -441,12 +461,56 @@ void R_DrawPlanes (void)
 		
 	stop = pl->maxx + 1;
 
-	for (x=pl->minx ; x<= stop ; x++)
+	if (clip_mode)
+	{
+	    draw_start = pl->minx < clip_left ? clip_left : pl->minx;
+	    draw_stop = stop < clip_right ? stop : clip_right;
+
+	    /* Start spans in the first owned column. This avoids reading or closing
+	     * span state from the preceding strip. */
+	    if (draw_start <= pl->maxx)
+	    {
+		for (y=PL_TOP(pl,draw_start) ;
+		    y<=PL_BOTTOM(pl,draw_start) && y<viewheight ; y++)
+		    spanstart[y] = draw_start;
+		draw_start++;
+	    }
+
+	    for (x=draw_start ; x<draw_stop ; x++)
+	    {
+		R_MakeSpans(x,PL_TOP(pl,x-1),
+			    PL_BOTTOM(pl,x-1),
+			    PL_TOP(pl,x),
+			    PL_BOTTOM(pl,x));
+	    }
+
+	    if (stop < clip_right)
+	    {
+		/* The plane ends in this strip. Consume its existing right sentinel. */
+		R_MakeSpans(stop,PL_TOP(pl,stop-1),
+			    PL_BOTTOM(pl,stop-1),
+			    PL_TOP(pl,stop),
+			    PL_BOTTOM(pl,stop));
+	    }
+	    else
+	    {
+		/* Close spans at the right edge without reading or building columns
+		 * owned by the next strip. */
+		x = clip_right - 1;
+		for (y=PL_TOP(pl,x) ; y<=PL_BOTTOM(pl,x) && y<viewheight ; y++)
+		    if (spanstart[y] <= x)
+			R_MapPlane(y,spanstart[y],x);
+	    }
+	}
+	else
 	{
-	    R_MakeSpans(x,PL_TOP(pl,x-1),
-			PL_BOTTOM(pl,x-1),
-			PL_TOP(pl,x),
-			PL_BOTTOM(pl,x));
+	    for (x=pl->minx ; x<= stop ; x++)
+	    {
+		R_MakeSpans(x,PL_TOP(pl,x-1),
+			    PL_BOTTOM(pl,x-1),
+			    PL_TOP(pl,x),
+			    PL_BOTTOM(pl,x));
+	    }
 	}
 	
 	Z_ChangeTag (ds_source, PU_CACHE);
