+static int32_t ds_sector_ref(ds_buf_t *b, sector_t *p, int required)
+{
+    int32_t id = ds_sector_id(p);
+    if ((required && id < 0) || (!required && p && id < 0)) b->bad = 1;
+    return id;
+}
+
+static int32_t ds_line_ref(ds_buf_t *b, line_t *p)
+{
+    int32_t id = ds_line_id(p);
+    if (p && id < 0) b->bad = 1;
+    return id;
+}
+
+static int32_t ds_state_ref(ds_buf_t *b, state_t *p, int required)
+{
+    int32_t id = ds_state_id(p);
+    if ((required && id < 0) || (!required && p && id < 0)) b->bad = 1;
+    return id;
+}
+
+static int32_t ds_player_ref(ds_buf_t *b, player_t *p)
+{
+    uintptr_t x, base;
+    if (!p) return 0;
+    x = (uintptr_t)p; base = (uintptr_t)players;
+    if (x < base || x - base >= sizeof(players)
+        || (x - base) % sizeof(*players)) { b->bad = 1; return 0; }
+    return (int32_t)((x - base) / sizeof(*players)) + 1;
+}
