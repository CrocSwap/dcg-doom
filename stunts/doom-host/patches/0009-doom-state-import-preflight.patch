+static uint32_t ds_mobj_ref(ds_buf_t *b, mobj_t **m, unsigned n, mobj_t *x)
+{
+    uint32_t id = ds_mobj_id(m, n, x);
+    if (x && !id) b->bad = 1;
+    return id;
+}
