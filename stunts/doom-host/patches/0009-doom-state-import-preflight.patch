+static void ds_rplayer(ds_read_t *r, player_t *p, uint32_t *mo, uint32_t *attacker)
+{
+    int i;
+    memset(p,0,sizeof(*p));
+    *mo=ds_r32(r); p->playerstate=(playerstate_t)ds_ri32(r);
+    p->cmd.forwardmove_m=(char)ds_r8(r); p->cmd.sidemove=(char)ds_r8(r);
+    p->cmd.angleturn=(short)ds_r16(r); p->cmd.consistancy_m=(short)ds_r16(r);
+    p->cmd.chatchar=ds_r8(r); p->cmd.buttons=ds_r8(r);
+    p->viewz_m=ds_ri32(r); p->viewheight_m=ds_ri32(r); p->deltaviewheight=ds_ri32(r);
+    p->bob=ds_ri32(r); p->health=ds_ri32(r); p->armorpoints=ds_ri32(r); p->armortype=ds_ri32(r);
+    for(i=0;i<NUMPOWERS;i++)p->powers[i]=ds_ri32(r);
+    for(i=0;i<NUMCARDS;i++)p->cards[i]=(boolean)ds_r8(r);
+    p->backpack=(boolean)ds_r8(r);
+    for(i=0;i<MAXPLAYERS;i++)p->frags[i]=ds_ri32(r);
+    p->readyweapon=(weapontype_t)ds_ri32(r); p->pendingweapon=(weapontype_t)ds_ri32(r);
+    for(i=0;i<NUMWEAPONS;i++)p->weaponowned[i]=(boolean)ds_r8(r);
+    for(i=0;i<NUMAMMO;i++)p->ammo[i]=ds_ri32(r);
+    for(i=0;i<NUMAMMO;i++)p->maxammo[i]=ds_ri32(r);
+    p->attackdown=ds_ri32(r); p->usedown=ds_ri32(r); p->cheats=ds_ri32(r); p->refire=ds_ri32(r);
+    p->killcount=ds_ri32(r); p->itemcount=ds_ri32(r); p->secretcount=ds_ri32(r);
+    p->damagecount=ds_ri32(r); p->bonuscount=ds_ri32(r); *attacker=ds_r32(r);
+    p->extralight_m=ds_ri32(r); p->fixedcolormap_m=ds_ri32(r); p->colormap=ds_ri32(r);
+    for(i=0;i<NUMPSPRITES;i++){
+        int32_t st=ds_ri32(r);
+        p->psprites[i].state=(st<0)?0:&states[st];
+        p->psprites[i].tics=ds_ri32(r); p->psprites[i].sx=ds_ri32(r); p->psprites[i].sy=ds_ri32(r);
+    }
+    p->didsecret=(boolean)ds_r8(r);
+}
+
+static void ds_player(ds_buf_t *b, const player_t *p, mobj_t **m, unsigned n)
+{
