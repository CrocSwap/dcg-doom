+    ds_r8(r); ds_r8(r); ds_r16(r); ds_r16(r); ds_r8(r); ds_r8(r);
+    for (i = 0; i < 7; i++)
+    {
+        value = ds_scan_i32(r);
+        if (i == 6 && (value < 0 || value > 2)) r->bad = 1;
+    }
+    for (i = 0; i < NUMPOWERS; i++) ds_scan_i32(r);
+    for (i = 0; i < NUMCARDS; i++) ds_scan_bool(r);
+    ds_scan_bool(r);
+    for (i = 0; i < MAXPLAYERS; i++) ds_scan_i32(r);
+    ready = ds_scan_i32(r); pending = ds_scan_i32(r);
+    if (ready < 0 || ready >= NUMWEAPONS
+        || (pending < 0 || pending > wp_nochange)) r->bad = 1;
+    for (i = 0; i < NUMWEAPONS; i++) ds_scan_bool(r);
+    for (i = 0; i < NUMAMMO; i++) ds_scan_i32(r);
+    for (i = 0; i < NUMAMMO; i++) ds_scan_i32(r);
+    for (i = 0; i < 9; i++)
+    {
+        value = ds_scan_i32(r);
+        if (i == 2 && (value & ~(CF_NOCLIP | CF_GODMODE | CF_NOMOMENTUM)))
+            r->bad = 1;
+    }
+    *attacker = ds_r32(r);
+    value = ds_scan_i32(r);
+    if (value < 0 || value > 31) r->bad = 1;
+    value = ds_scan_i32(r);
+    if (value < 0 || value > 3) r->bad = 1;
+    ds_scan_i32(r);
+    for (i = 0; i < NUMPSPRITES; i++)
+    {
+        int32_t state = ds_scan_i32(r);
+        ds_scan_i32(r); ds_scan_i32(r); ds_scan_i32(r);
+        if (state < -1 || state >= NUMSTATES)
+            r->bad = 1;
+    }
+    ds_scan_bool(r);
+}
+
+static void ds_scan_mapthing(ds_read_t *r)
+{
+    ds_r16(r); ds_r16(r); ds_r16(r); ds_r16(r); ds_r16(r);
+}
+
+static int ds_scan_special(ds_read_t *r, ds_plan_t *p, unsigned si,
+                           unsigned k)
+{
+    int32_t sector, value;
+    switch (k)
+    {
+    case DS_CEILING:
+        value = ds_scan_i32(r); sector = ds_scan_i32(r);
+        if (value < lowerToFloor || value > silentCrushAndRaise) return -1;
+        ds_scan_i32(r); ds_scan_i32(r); ds_scan_i32(r);
+        ds_scan_bool(r); value = ds_scan_i32(r);
+        if (value < -1 || value > 1) return -1;
+        ds_scan_i32(r); ds_scan_i32(r);
+        break;
+    case DS_DOOR:
+        value = ds_scan_i32(r); sector = ds_scan_i32(r);
+        if (value < normal || value > blazeClose) return -1;
+        ds_scan_i32(r); ds_scan_i32(r); value = ds_scan_i32(r);
+        if (value < -1 || value > 1) return -1;
+        ds_scan_i32(r); ds_scan_i32(r);
+        break;
+    case DS_FLOOR:
+        value = ds_scan_i32(r); ds_scan_bool(r); sector = ds_scan_i32(r);
+        if (value < lowerFloor || value > raiseFloor512) return -1;
+        value = ds_scan_i32(r); if (value < -1 || value > 1) return -1;
+        ds_scan_i32(r); value = (int16_t)ds_r16(r);
+        if (value < -1 || value >= numflats) return -1;
+        ds_scan_i32(r); ds_scan_i32(r);
+        break;
+    case DS_PLAT:
+        sector = ds_scan_i32(r);
+        ds_scan_i32(r); ds_scan_i32(r); ds_scan_i32(r); ds_scan_i32(r);
+        ds_scan_i32(r);
+        value = ds_scan_i32(r); if (value < up || value > in_stasis) return -1;
+        value = ds_scan_i32(r); if (value < up || value > in_stasis) return -1;
+        ds_scan_bool(r);
+        ds_scan_i32(r); ds_scan_i32(r);
+        value = ds_scan_i32(r);
+        if (value < perpetualRaise || value > blazeDWUS) return -1;
+        break;
+    case DS_FLASH:
+        sector = ds_scan_i32(r);
+        ds_scan_i32(r); ds_scan_i32(r); ds_scan_i32(r);
+        ds_scan_i32(r); ds_scan_i32(r);
+        break;
+    case DS_STROBE:
+        sector = ds_scan_i32(r);
+        ds_scan_i32(r); ds_scan_i32(r); ds_scan_i32(r);
+        ds_scan_i32(r); ds_scan_i32(r);
+        break;
+    case DS_GLOW:
+        sector = ds_scan_i32(r);
+        ds_scan_i32(r); ds_scan_i32(r); ds_scan_i32(r);
+        break;
+    case DS_FIREFLICKER:
+        sector = ds_scan_i32(r);
+        ds_scan_i32(r); ds_scan_i32(r); ds_scan_i32(r);
+        break;
+    default:
+        return -1;
+    }
+    if (sector < 0 || sector >= numsectors)
+        return -1;
+    /* Only these thinker kinds write sector->specialdata.  Lighting
+     * thinkers intentionally coexist on one sector in the v0 capture. */
+    if (k <= DS_PLAT && p->sector_owner[sector]) return -1;
+    if (k <= DS_PLAT) p->sector_owner[sector] = 1;
+    p->special_sector[si] = sector;
+    return 0;
+}
+
+static void ds_scan_mobj(ds_read_t *r, ds_plan_t *p, unsigned mi)
+{
+    int i;
+    int32_t type, state, player, sprite, frame, movedir;
+    ds_scan_i32(r); ds_scan_i32(r); ds_scan_i32(r); ds_r32(r);
+    sprite = ds_scan_i32(r);
+    frame = ds_scan_i32(r);
+    for (i = 2; i < 9; i++) ds_scan_i32(r);
+    ds_scan_i32(r);
+    type = ds_scan_i32(r);
+    ds_scan_i32(r);
+    state = ds_scan_i32(r);
+    ds_scan_i32(r); ds_scan_i32(r);
+    movedir = ds_scan_i32(r);
+    ds_scan_i32(r);
+    p->mtarget[mi] = ds_r32(r);
+    ds_scan_i32(r); ds_scan_i32(r);
+    player = ds_scan_i32(r);
+    ds_scan_i32(r); ds_scan_mapthing(r);
+    p->mtracer[mi] = ds_r32(r);
+    p->mplayer[mi] = player;
+    if (sprite < 0 || sprite >= NUMSPRITES
+        || frame < 0 || (frame & ~FF_FULLBRIGHT) > FF_FRAMEMASK
+        || type < 0 || type >= NUMMOBJTYPES
+        || state < 0 || state >= NUMSTATES
+        || movedir < 0 || movedir > 8
+        || player < 0 || player > MAXPLAYERS)
+        r->bad = 1;
+}
+
+static int ds_ref_ok(uint32_t id, unsigned n)
+{
+    return id == 0 || id <= n;
+}
+
+static int ds_preflight(const uint8_t *image, size_t image_bytes,
+                        ds_plan_t *p, unsigned profile)
+{
+    ds_read_t r;
+    uint32_t nmo, nsp, nrec;
+    unsigned i, j, kind, line_sides;
+    memset(p, 0, sizeof(*p));
+    if (!image || image_bytes < DS_HEADER_BYTES
+        || image_bytes > DS_MAX_IMAGE_BYTES
+        || image_bytes > 0xffffffffU
+        || memcmp(image, "DOOM-ST1", 8)
+        || ds_at32(image + 8) != profile
+        || ds_at32(image + 12) != DS_HEADER_BYTES
+        || ds_at32(image + 16) != (uint32_t)image_bytes
+        || ds_at32(image + 36) != (uint32_t)numsectors
+        || ds_at32(image + 40) != (uint32_t)(DOOM_CTX->numlines)
+        || ds_at32(image + 44) != (uint32_t)numsides
+        || ds_at32(image + 48) != (uint32_t)numflats
+        || ds_at32(image + 52) != (uint32_t)numtextures)
+        return -1;
+    for (i = 60; i < DS_HEADER_BYTES; i++)
+        if (image[i])
+            return -1;
+    nmo = ds_at32(image + 28);
+    nsp = ds_at32(image + 32);
+    nrec = ds_at32(image + 56);
+    if (nmo > DS_MAX_OBJECTS || nsp > DS_MAX_OBJECTS
+        || nrec > DS_MAX_OBJECTS || nmo + nsp != nrec)
+        return -1;
+    p->nmo = nmo; p->nsp = nsp; p->nrec = nrec;
+    p->sector_soundtarget_count = (uint32_t)numsectors;
+    p->sector_owner = numsectors
+        ? ds_alloc_bytes((size_t)numsectors, 1) : 0;
+    p->sector_soundtarget = numsectors
+        ? ds_alloc_bytes((size_t)numsectors * sizeof(*p->sector_soundtarget), 1) : 0;
+    if (numsectors && (!p->sector_owner || !p->sector_soundtarget))
+        goto bad;
+    memset(&r, 0, sizeof(r)); r.p = image; r.cap = image_bytes;
+    r.used = DS_HEADER_BYTES;
+    for (i = 0; i < 21; i++) p->globals[i] = ds_scan_i32(&r);
+    p->saved_gametic = p->globals[5];
+    if (p->globals[0] < sk_baby || p->globals[0] > sk_nightmare
+        || p->globals[1] != 1 || p->globals[2] < 1 || p->globals[2] > 9
+        || p->globals[3] < GS_LEVEL || p->globals[3] > GS_DEMOSCREEN
+        || p->globals[4] < ga_nothing || p->globals[4] > ga_screenshot
+        || p->globals[11] < 0 || p->globals[11] >= MAXPLAYERS
+        || p->globals[12] < 0 || p->globals[12] >= MAXPLAYERS
+        || p->globals[13] < 0 || p->globals[13] >= numtextures
+        || p->globals[14] < 0 || p->globals[14] >= numflats
+        || p->globals[5] < 0 || p->globals[6] < 0 || p->globals[7] < 0
+        || p->globals[8] < 0 || p->globals[9] < 0 || p->globals[10] < 0
+        || p->globals[15] < 0 || p->globals[15] >= 256
+        || p->globals[16] < 0 || p->globals[16] >= 256
+        || p->globals[17] < 0
+        || p->globals[18] < 0 || p->globals[18] >= 50
+        || p->globals[19] < 0 || p->globals[19] >= DS_BODYQUESIZE
+        || p->globals[20] < 0
+        || ds_at32(image + 20) != (uint32_t)p->saved_gametic)
+        goto bad;
+    for (i = 0; i < 12 + MAXPLAYERS; i++)
+        p->booleans[i] = ds_scan_bool(&r);
+    if (!p->booleans[12 + p->globals[11]])
+        goto bad;
+    for (i = 0; i < MAXPLAYERS; i++)
+        ds_scan_player(&r, &p->pm[i], &p->pa[i]);
+    for (i = 0; i < DS_BODYQUESIZE; i++) p->body[i] = ds_r32(&r);
+    for (i = 0; i < (unsigned)numsectors; i++)
+    {
+        int k;
+        int32_t value;
+        for (k = 0; k < 2; k++) ds_scan_i32(&r);
+        value = (int16_t)ds_r16(&r);
+        if (value < 0 || value >= numflats) goto bad;
+        value = (int16_t)ds_r16(&r);
+        if (value < 0 || value >= numflats) goto bad;
+        for (k = 2; k < 5; k++) ds_r16(&r);
+        ds_scan_i32(&r);
+        p->sector_soundtarget[i] = ds_r32(&r);
+        for (k = 0; k < 4; k++)
+        {
+            value = ds_scan_i32(&r);
+            if (value < 0 || value >= (k < 2 ? bmapheight : bmapwidth)) goto bad;
+        }
+        ds_scan_i32(&r);
+    }
+    for (i = 0; i < (unsigned)(DOOM_CTX->numlines); i++)
+    {
+        int k;
+        ds_r16(&r); ds_r16(&r); ds_r16(&r);
+        for (j = 0, line_sides = 0; j < 2; j++)
+        {
+            if (lines[i].sidenum[j] < -1
+                || lines[i].sidenum[j] >= numsides)
+            { r.bad = 1; continue; }
+            if (lines[i].sidenum[j] != -1) line_sides++;
+        }
+        for (j = 0; j < line_sides; j++)
+        {
+            ds_scan_i32(&r); ds_scan_i32(&r);
+            for (k = 0; k < 3; k++)
+            {
+                int32_t texture = (int16_t)ds_r16(&r);
+                if (texture < -1 || texture >= numtextures) goto bad;
+            }
+        }
+        ds_scan_i32(&r);
+    }
+    for (i = 0; i <= (unsigned)numflats; i++)
+    {
+        int32_t value = ds_scan_i32(&r);
+        if (value < 0 || value > numflats) goto bad;
+    }
+    for (i = 0; i <= (unsigned)numtextures; i++)
+    {
+        int32_t value = ds_scan_i32(&r);
+        if (value < 0 || value > numtextures) goto bad;
+    }
+    for (i = 0; i < ITEMQUESIZE; i++)
+    { ds_scan_mapthing(&r); if (ds_scan_i32(&r) < 0) goto bad; }
+    {
+        int32_t head = ds_scan_i32(&r), tail = ds_scan_i32(&r);
+        if (head < 0 || head >= ITEMQUESIZE || tail < 0 || tail >= ITEMQUESIZE)
+            goto bad;
+        p->saved_iquehead = head; p->saved_iquetail = tail;
+    }
+    for (i = 0; i < MAXBUTTONS; i++)
+    {
+        p->button_shadow[i].line = ds_scan_i32(&r);
+        p->button_shadow[i].where = ds_scan_i32(&r);
+        p->button_shadow[i].btexture = ds_scan_i32(&r);
+        p->button_shadow[i].btimer = ds_scan_i32(&r);
+        p->button_shadow[i].soundorg = ds_r32(&r);
+        if (p->button_shadow[i].line < -1
+            || p->button_shadow[i].line >= DOOM_CTX->numlines
+            || p->button_shadow[i].where < top
+            || p->button_shadow[i].where > bottom
+            || p->button_shadow[i].btexture < -1
+            || p->button_shadow[i].btexture >= numtextures
+            || p->button_shadow[i].btimer < 0)
+            goto bad;
+    }
+    for (i = 0; i < nrec && !r.bad; i++)
+    {
+        kind = ds_r8(&r);
+        if (!ds_supported_kind(kind)) goto bad;
+        p->kinds[i] = kind;
+        if (kind == DS_MOBJ)
+        {
+            if (p->mobj_actual >= nmo) goto bad;
+            ds_scan_mobj(&r, p, p->mobj_actual++);
+        }
+        else
+        {
+            if (p->special_actual >= nsp
+                || ds_scan_special(&r, p, p->special_actual, kind))
+                goto bad;
+            if (kind == DS_CEILING && ++p->ceiling_count > MAXCEILINGS)
+                goto bad;
+            if (kind == DS_PLAT && ++p->plat_count > MAXPLATS)
+                goto bad;
+            p->special_kinds[p->special_actual] = kind;
+            p->special_actual++;
+        }
+    }
+    if (r.bad || r.used != r.cap
+        || p->mobj_actual != nmo || p->special_actual != nsp
+        || ds_at32(image + 20) != (uint32_t)p->saved_gametic)
+        goto bad;
+    if (!demobuffer
+        || ds_at32(image + 24) < 13
+        || ds_at32(image + 24) > (uint32_t)W_LumpLength(W_GetNumForName(defdemoname)))
+        goto bad;
+    for (i = 0; i < MAXPLAYERS; i++)
+    {
+        if (!ds_ref_ok(p->pm[i], nmo) || !ds_ref_ok(p->pa[i], nmo)) goto bad;
+    }
+    for (i = 0; i < DS_BODYQUESIZE; i++)
+        if (!ds_ref_ok(p->body[i], nmo)) goto bad;
+    for (i = 0; i < (unsigned)numsectors; i++)
+        if (!ds_ref_ok(p->sector_soundtarget[i], nmo)) goto bad;
+    for (i = 0; i < MAXBUTTONS; i++)
+        if (!ds_ref_ok(p->button_shadow[i].soundorg, nmo)) goto bad;
+    for (i = 0; i < nmo; i++)
+    {
+        if (!ds_ref_ok(p->mtarget[i], nmo)
+            || !ds_ref_ok(p->mtracer[i], nmo)) goto bad;
+        if (p->mplayer[i] < 0 || p->mplayer[i] > MAXPLAYERS) goto bad;
+    }
+    for (i = 0; i < nmo; i++)
+        if (p->mplayer[i]
+            && p->pm[p->mplayer[i] - 1] != i + 1) goto bad;
+    for (i = 0; i < MAXPLAYERS; i++)
+        if (p->pm[i]
+            && p->mplayer[p->pm[i] - 1] != (int32_t)i + 1) goto bad;
+    return 0;
+bad:
+    ds_plan_release(p, 0);
+    return -1;
+}
+
+static int ds_plan_prepare(ds_plan_t *p)
+{
+    unsigned i;
+    p->sector_shadow = numsectors
+        ? ds_alloc_bytes((size_t)numsectors * sizeof(*p->sector_shadow), 1) : 0;
+    p->line_shadow = DOOM_CTX->numlines
+        ? ds_alloc_bytes((size_t)DOOM_CTX->numlines * sizeof(*p->line_shadow), 1) : 0;
+    p->flat_translation = ds_alloc_bytes(
+        ((size_t)numflats + 1) * sizeof(*p->flat_translation), 1);
+    p->texture_translation = ds_alloc_bytes(
+        ((size_t)numtextures + 1) * sizeof(*p->texture_translation), 1);
+    p->item_shadow = ds_alloc_bytes(
+        (size_t)ITEMQUESIZE * sizeof(*p->item_shadow), 1);
+    if ((numsectors && !p->sector_shadow)
+        || (DOOM_CTX->numlines && !p->line_shadow)
+        || !p->flat_translation || !p->texture_translation || !p->item_shadow)
+        goto bad;
+    for (i = 0; i < p->nmo; i++)
+    {
+        p->mobj_mem[i] = ds_zone_alloc(sizeof(mobj_t));
+        if (!p->mobj_mem[i]) goto bad;
+    }
+    for (i = 0; i < p->nsp; i++)
+    {
+        p->special_mem[i] = ds_zone_alloc(ds_special_size(p->special_kinds[i]));
+        if (!p->special_mem[i]) goto bad;
+    }
+    return 0;
+bad:
+    ds_plan_release(p, 1);
+    return -1;
+}
+
+/* The caller must not tear down the committed graph before preflight.  This
+ * is the only destructive step, reached after every decoder allocation has
+ * succeeded and the strict scan has accepted the whole image. */
+static void ds_release_current_thinkers(void)
+{
+    thinker_t *t = thinkercap.next, *next;
+    while (t != &thinkercap)
+    {
+        next = t->next;
+        Z_Free(t);
+        t = next;
+    }
+}
