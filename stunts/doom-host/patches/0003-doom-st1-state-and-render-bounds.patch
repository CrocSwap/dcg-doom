index 00000000..8a45ed4c
--- /dev/null
+++ b/linuxdoom-1.10/headless/doom_state.c
@@ -0,0 +1,164 @@
+/*
+ * DOOM-ST1 v0: canonical, host-width-independent state codec for the
+ * retained one-player E1M1 headless path.  Every scalar is emitted by an
+ * explicit little-endian writer.  Pointer-bearing engine links are emitted as
+ * zero/null, map-array indexes, player indexes, or 1-based thinker slots.
+ */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "doomdef.h"
+#include "doomstat.h"
+#include "g_game.h"
+#include "m_random.h"
+#include "p_local.h"
+#include "p_spec.h"
+#include "r_data.h"
+#include "r_local.h"
+#include "r_main.h"
+#include "r_state.h"
+#include "w_wad.h"
+#include "z_zone.h"
+#include "doom_state.h"
+
+#define DS_HEADER_BYTES 64u
+#define DS_MAX_OBJECTS 1024u
+#define DS_BODYQUESIZE 32u
+
+enum ds_record_kind {
+    DS_MOBJ = 1,
+    DS_CEILING = 2,
+    DS_DOOR = 3,
+    DS_FLOOR = 4,
+    DS_PLAT = 5,
+    DS_FLASH = 6,
+    DS_STROBE = 7,
+    DS_GLOW = 8,
+    DS_FIREFLICKER = 9,
+    DS_MOBJ_REMOVED = 10
+};
+
+typedef struct { uint8_t *p; size_t used, cap; int bad; } ds_buf_t;
+typedef struct { const uint8_t *p; size_t used, cap; int bad; } ds_read_t;
+
+extern int prndindex;
+extern int skytexture;
+extern int fuzzpos;
+extern int numflats;
+extern mobj_t *bodyque[DS_BODYQUESIZE];
+extern boolean sendpause, sendsave, netdemo, demorecording, demoplayback;
+extern boolean respawnmonsters, secretexit;
+extern gameaction_t gameaction;
+extern byte *demobuffer, *demo_p;
+extern int numtextures;
+extern void T_FireFlicker(fireflicker_t *flick);
+
+/* The SHA implementation lives in the headless driver.  Keep the state
+ * helper local so the image can also be hashed from a fresh process. */
+typedef struct { uint32_t h[8]; uint64_t bits; uint8_t block[64]; size_t used; } ds_sha256_t;
+static const uint32_t ds_k[64] = {
+  0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
+  0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
+  0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
+  0x983e5152,0xa831c66d,0xb00327c8,0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,
+  0xd6990624,0xf40e3585,0x106aa070,0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,
+  0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,
+  0xa4506ceb,0xbef9a3f7,0xc67178f2
+};
+static uint32_t ds_rotr(uint32_t x, unsigned n) { return (x >> n) | (x << (32 - n)); }
+static void ds_sha_block(ds_sha256_t *s, const uint8_t *p) {
+    uint32_t w[64], a,b,c,d,e,f,g,h,t1,t2; int i;
+    for (i=0;i<16;i++) w[i]=((uint32_t)p[i*4]<<24)|((uint32_t)p[i*4+1]<<16)|((uint32_t)p[i*4+2]<<8)|p[i*4+3];
+    for (;i<64;i++) { uint32_t x=w[i-15], y=w[i-2]; w[i]=w[i-16]+(ds_rotr(x,7)^ds_rotr(x,18)^(x>>3))+w[i-7]+(ds_rotr(y,17)^ds_rotr(y,19)^(y>>10)); }
+    a=s->h[0];b=s->h[1];c=s->h[2];d=s->h[3];e=s->h[4];f=s->h[5];g=s->h[6];h=s->h[7];
+    for (i=0;i<64;i++) { uint32_t s1=ds_rotr(e,6)^ds_rotr(e,11)^ds_rotr(e,25), ch=(e&f)^((~e)&g), s0=ds_rotr(a,2)^ds_rotr(a,13)^ds_rotr(a,22), maj=(a&b)^(a&c)^(b&c); t1=h+s1+ch+ds_k[i]+w[i]; t2=s0+maj; h=g;g=f;f=e;e=d+t1;d=c;c=b;b=a;a=t1+t2; }
+    s->h[0]+=a;s->h[1]+=b;s->h[2]+=c;s->h[3]+=d;s->h[4]+=e;s->h[5]+=f;s->h[6]+=g;s->h[7]+=h;
+}
+static void ds_sha_init(ds_sha256_t *s) { static const uint32_t iv[8]={0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19}; memcpy(s->h,iv,sizeof(iv));s->bits=0;s->used=0; }
+static void ds_sha_update(ds_sha256_t *s,const void *data,size_t n) { const uint8_t *p=data; s->bits+=(uint64_t)n*8; while(n){size_t take=64-s->used;if(take>n)take=n;memcpy(s->block+s->used,p,take);s->used+=take;p+=take;n-=take;if(s->used==64){ds_sha_block(s,s->block);s->used=0;}} }
+static void ds_sha_final(ds_sha256_t *s,uint8_t out[32]) { uint8_t len[8]; int i; for(i=0;i<8;i++)len[7-i]=(uint8_t)(s->bits>>(i*8)); s->block[s->used++]=0x80; if(s->used>56){while(s->used<64)s->block[s->used++]=0;ds_sha_block(s,s->block);s->used=0;}while(s->used<56)s->block[s->used++]=0;memcpy(s->block+56,len,8);ds_sha_block(s,s->block);for(i=0;i<8;i++){out[i*4]=(uint8_t)(s->h[i]>>24);out[i*4+1]=(uint8_t)(s->h[i]>>16);out[i*4+2]=(uint8_t)(s->h[i]>>8);out[i*4+3]=(uint8_t)s->h[i];} }
+
+static void ds_need(ds_buf_t *b, size_t n) { uint8_t *q; size_t cap; if (b->bad) return; if (n <= b->cap-b->used) return; cap=b->cap?b->cap:4096; while (n>cap-b->used) { if (cap>(size_t)-1/2) { b->bad=1; return; } cap*=2; } q=realloc(b->p,cap); if(!q){b->bad=1;return;} b->p=q;b->cap=cap; }
+static void ds_u8(ds_buf_t *b, uint8_t x) { ds_need(b,1);if(!b->bad)b->p[b->used++]=x; }
+static void ds_u16(ds_buf_t *b, uint16_t x) { ds_u8(b,(uint8_t)x);ds_u8(b,(uint8_t)(x>>8)); }
+static void ds_u32(ds_buf_t *b, uint32_t x) { ds_u16(b,(uint16_t)x);ds_u16(b,(uint16_t)(x>>16)); }
+static void ds_i32(ds_buf_t *b, int32_t x) { ds_u32(b,(uint32_t)x); }
+static void ds_bytes(ds_buf_t *b, const void *p, size_t n) { ds_need(b,n);if(!b->bad){memcpy(b->p+b->used,p,n);b->used+=n;} }
+static uint8_t ds_r8(ds_read_t *r) { if(r->bad||r->used==r->cap){r->bad=1;return 0;}return r->p[r->used++]; }
+static uint16_t ds_r16(ds_read_t *r) { uint16_t a=ds_r8(r),b=ds_r8(r);return (uint16_t)(a|(b<<8)); }
+static uint32_t ds_r32(ds_read_t *r) { uint32_t a=ds_r16(r),b=ds_r16(r);return a|(b<<16); }
+static int32_t ds_ri32(ds_read_t *r) { return (int32_t)ds_r32(r); }
+static void ds_rbytes(ds_read_t *r, void *p, size_t n) { if(r->bad||n>r->cap-r->used){r->bad=1;return;}memcpy(p,r->p+r->used,n);r->used+=n; }
+static void ds_set32(uint8_t *p,uint32_t x) {p[0]=(uint8_t)x;p[1]=(uint8_t)(x>>8);p[2]=(uint8_t)(x>>16);p[3]=(uint8_t)(x>>24);}
+static uint32_t ds_at32(const uint8_t *p){return (uint32_t)p[0]|((uint32_t)p[1]<<8)|((uint32_t)p[2]<<16)|((uint32_t)p[3]<<24);}
+
+static uint32_t ds_mobj_id(mobj_t **m, unsigned n, mobj_t *x) { unsigned i; if(!x)return 0;for(i=0;i<n;i++)if(m[i]==x)return i+1;return 0; }
+static mobj_t *ds_mobj_at(mobj_t **m,unsigned n,uint32_t id){if(!id)return 0;if(id>n)return 0;return m[id-1];}
+static int32_t ds_sector_id(sector_t *p) { if(!p)return -1;if(p<sectors||p>=sectors+numsectors)return -1;return (int32_t)(p-sectors); }
