 #ifndef __R_LOCAL__
 #define __R_LOCAL__
 
+/* Strip-bounded scene walk.  Clip mode 2 renders one 40-column strip of the
+ * 320-wide view.  The bound belongs where a wall range is stored, not in the
+ * clip posts: solidsegs drives R_CheckBBox, and the subsectors R_CheckBBox
+ * rejects decide which sprites enter the vissprite list, which decides the
+ * global fuzz column stream (R_DrawFuzzColumn is the only writer of
+ * doom_render_fuzz_columns and only a shadow sprite uses it).  Bounding the
+ * posts, or returning from R_AddLine before R_ClipSolidWallSegment and
+ * R_ClipPassWallSegment update them, changes that stream and shifts the fuzz
+ * phase of the in-strip columns.  Mode 1 and mode 0 never test these. */
+#define DOOM_CLIP_MODE_2 (((doom_render_fuzz_columns >> 30) & 3u) == 2u)
+#define DOOM_CLIP_LEFT_2 ((int)(((doom_render_fuzz_columns >> 27) & 7u) * 40u))
+#define DOOM_CLIP_RIGHT_2 (DOOM_CLIP_LEFT_2 + 40)
+
