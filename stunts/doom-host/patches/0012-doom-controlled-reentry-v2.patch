Subject: [PATCH 0012] Add explicit Doom host continuation v2

DOOM-HOST-CREENTRY-2 preserves the legacy CI1/CI2/ST1/MP1/PUB1/EX1
behavior and introduces a separate CI2 ingress option. V2 consumes one
validated captured DEMO1 command slot at G_Ticker and publishes the strict
successor only after the host gametic advances; it is host-only.

diff --git a/linuxdoom-1.10/headless/doom_controller.h b/linuxdoom-1.10/headless/doom_controller.h
--- a/linuxdoom-1.10/headless/doom_controller.h
+++ b/linuxdoom-1.10/headless/doom_controller.h
@@ -2,6 +2,7 @@
 #define DOOM_CONTROLLER_H
 
 #include <stdint.h>
+#include <stddef.h>
 #include "d_ticcmd.h"
 
 /* DOOM-CI1 v1: the four bytes are the captured ticcmd at byte 24. */
@@ -15,4 +16,12 @@
 int DoomControllerArm(const uint8_t[4]);
 int DoomControllerApplyTiccmd(ticcmd_t *);
 
+/* DOOM-HOST-CREENTRY-2 uses the same CI2 bytes but advances the captured
+ * DEMO1 cursor for the supplied command.  The bound is the real lump bound,
+ * not the allocator bound used by the legacy demo loader. */
+void DoomControllerSetCapturedDemoBounds(const uint8_t *, size_t);
+int DoomControllerValidateCapturedDemoCursor(const uint8_t *);
+int DoomControllerArmV2(const uint8_t[4]);
+int DoomControllerApplyTiccmdV2(ticcmd_t *, uint8_t **);
+
 #endif
diff --git a/linuxdoom-1.10/headless/doom_controller.c b/linuxdoom-1.10/headless/doom_controller.c
--- a/linuxdoom-1.10/headless/doom_controller.c
+++ b/linuxdoom-1.10/headless/doom_controller.c
@@ -46,8 +46,21 @@
 }
 
 static int controller_armed;
+static int controller_v2_armed;
 static uint8_t controller_command[4];
+static const uint8_t *captured_demo_begin;
+static const uint8_t *captured_demo_end;
 
+static void apply_command(ticcmd_t *cmd)
+{
+    cmd->forwardmove_m = (char)controller_command[0];
+    cmd->sidemove = (char)controller_command[1];
+    cmd->angleturn = ((unsigned char)controller_command[2]) << 8;
+    cmd->consistancy_m = 0;
+    cmd->chatchar = 0;
+    cmd->buttons = controller_command[3];
+}
+
 int DoomControllerArm(const uint8_t command[4])
 {
     if (!command)
@@ -57,16 +70,64 @@
     return 0;
 }
 
+void DoomControllerSetCapturedDemoBounds(const uint8_t *begin, size_t bytes)
+{
+    captured_demo_begin = begin;
+    captured_demo_end = begin ? begin + bytes : 0;
+}
+
+int DoomControllerValidateCapturedDemoCursor(const uint8_t *cursor)
+{
+    return cursor && captured_demo_begin && captured_demo_end
+        && cursor >= captured_demo_begin && cursor <= captured_demo_end
+        && (size_t)(captured_demo_end - cursor) >= 4
+        && *cursor != 0x80 ? 0 : -1;
+}
+
+int DoomControllerArmV2(const uint8_t command[4])
+{
+    if (!command || !captured_demo_begin || !captured_demo_end
+        || captured_demo_end < captured_demo_begin)
+        return -1;
+    memcpy(controller_command, command, sizeof(controller_command));
+    controller_v2_armed = 1;
+    return 0;
+}
+
 int DoomControllerApplyTiccmd(ticcmd_t *cmd)
 {
     if (!controller_armed || !cmd)
         return 0;
-    cmd->forwardmove_m = (char)controller_command[0];
-    cmd->sidemove = (char)controller_command[1];
-    cmd->angleturn = ((unsigned char)controller_command[2]) << 8;
-    cmd->consistancy_m = 0;
-    cmd->chatchar = 0;
-    cmd->buttons = controller_command[3];
+    apply_command(cmd);
     controller_armed = 0;
     return 1;
 }
+
+int DoomControllerApplyTiccmdV2(ticcmd_t *cmd, uint8_t **cursor)
+{
+    if (!controller_v2_armed)
+        return 0;
+#ifdef DOOM_SIM2_UNBOUNDED_INPUT
+    if (!cmd || !cursor || !*cursor) {
+        controller_v2_armed = 0;
+        return -1;
+    }
+    /* Continue accepting committed SIM/2 commands after DEMO1 ends. Keep
+     * demo_p at its valid end marker once there are no more captured tics. */
+    if (!DoomControllerValidateCapturedDemoCursor(*cursor))
+        *cursor += 4;
+    apply_command(cmd);
+    controller_v2_armed = 0;
+    return 1;
+#else
+    if (!cmd || !cursor || !*cursor
+        || DoomControllerValidateCapturedDemoCursor(*cursor)) {
+        controller_v2_armed = 0;
+        return -1;
+    }
+    *cursor += 4;
+    apply_command(cmd);
+    controller_v2_armed = 0;
+    return 1;
+#endif
+}
