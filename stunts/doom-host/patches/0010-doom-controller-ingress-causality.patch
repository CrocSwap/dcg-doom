Subject: [PATCH 0010] Add bounded controller ingress at G_Ticker

The prior DOOM-CI1 adapter checked its bytes against the queued DEMO1
command. Keep that legacy path for the captured-tick receipt, but add an
explicitly versioned DOOM-CI2 one-shot ingress that supplies ticcmd_t at the
actual G_Ticker command boundary. The host harness bounds it to one loaded
state and one player; it is not an interactive or chain interface.

diff --git a/linuxdoom-1.10/g_game.c b/linuxdoom-1.10/g_game.c
--- a/linuxdoom-1.10/g_game.c
+++ b/linuxdoom-1.10/g_game.c
@@ -71,4 +71,5 @@
 #include "g_game.h"
 
+#include "doom_controller.h"
 
 #define SAVEGAMESIZE	0x2c000
@@ -586,1 +586,1 @@
-	    if (demoplayback) 
+	    if (!DoomControllerApplyTiccmd(cmd) && demoplayback)
diff --git a/linuxdoom-1.10/headless/doom_controller.h b/linuxdoom-1.10/headless/doom_controller.h
--- a/linuxdoom-1.10/headless/doom_controller.h
+++ b/linuxdoom-1.10/headless/doom_controller.h
@@ -4,6 +4,12 @@
 #include <stdint.h>
+#include "d_ticcmd.h"
 
 /* DOOM-CI1 v1: the four bytes are the captured ticcmd at byte 24. */
 #define DOOM_CONTROLLER_BYTES 64
 
 int DoomControllerRead(const char *, uint32_t, uint8_t[4]);
+
+/* DOOM-CI2 v1 is an explicit one-shot runtime ingress. Its four command
+ * bytes have the same LMP encoding, but are not compared with demo_p. */
+int DoomControllerReadIngress(const char *, uint32_t, uint8_t[4]);
+int DoomControllerArm(const uint8_t[4]);
+int DoomControllerApplyTiccmd(ticcmd_t *);
diff --git a/linuxdoom-1.10/headless/doom_controller.c b/linuxdoom-1.10/headless/doom_controller.c
--- a/linuxdoom-1.10/headless/doom_controller.c
+++ b/linuxdoom-1.10/headless/doom_controller.c
@@ -2,4 +2,5 @@
 #include <stdio.h>
 #include <stdint.h>
 #include <string.h>
+#include "d_ticcmd.h"
 #include "doom_controller.h"
@@ -13,1 +13,2 @@
-int DoomControllerRead(const char *path, uint32_t expected_gametic, uint8_t out[4])
+static int read_account(const char *path, const char magic[8],
+                        uint32_t expected_gametic, uint8_t out[4])
@@ -26,1 +26,1 @@
-    if (extra != EOF || memcmp(b, "DOOM-CI1", 8)
+    if (extra != EOF || memcmp(b, magic, 8)
@@ -31,3 +35,34 @@
     memcpy(out, b + 24, 4);
     return 0;
 }
+
+int DoomControllerRead(const char *path, uint32_t expected_gametic, uint8_t out[4])
+{
+    return read_account(path, "DOOM-CI1", expected_gametic, out);
+}
+
+int DoomControllerReadIngress(const char *path, uint32_t expected_gametic,
+                              uint8_t out[4])
+{
+    return read_account(path, "DOOM-CI2", expected_gametic, out);
+}
+
+static int controller_armed;
+static uint8_t controller_command[4];
+
+int DoomControllerArm(const uint8_t command[4])
+{
+    if (!command)
+        return -1;
+    memcpy(controller_command, command, sizeof(controller_command));
+    controller_armed = 1;
+    return 0;
+}
+
+int DoomControllerApplyTiccmd(ticcmd_t *cmd)
+{
+    if (!controller_armed || !cmd)
+        return 0;
+    cmd->forwardmove_m = (char)controller_command[0];
+    cmd->sidemove = (char)controller_command[1];
+    cmd->angleturn = ((unsigned char)controller_command[2]) << 8;
+    cmd->consistancy_m = 0;
+    cmd->chatchar = 0;
+    cmd->buttons = controller_command[3];
+    controller_armed = 0;
+    return 1;
+}
diff --git a/linuxdoom-1.10/headless/doom_headless.c b/linuxdoom-1.10/headless/doom_headless.c
