+/* Strip-bounded scene walk.  Clip mode 2 renders one 40-column strip of the
+ * 320-wide view.  The bound belongs inside R_RenderSegLoop's per-column loop
+ * and not in the clip posts: solidsegs drives R_CheckBBox, and the
+ * subsectors R_CheckBBox rejects decide which sprites enter the vissprite
+ * list, so bounding the posts changes the sprite draw order.  The bound also
+ * may not skip a seg before the R_CheckPlane calls at the end of
+ * R_StoreWallRange: ceilingplane and floorplane are file-static and chain
+ * across segs there, so an out-of-strip seg that returns early leaves the
+ * next seg's markfloor/markceiling marks on the wrong plane.  Mode 1 and mode
+ * 0 never test these. */
+#define DOOM_CLIP_MODE_2 (((doom_render_fuzz_columns >> 30) & 3u) == 2u)
+#define DOOM_CLIP_LEFT_2 ((int)(((doom_render_fuzz_columns >> 27) & 7u) * 40u))
+#define DOOM_CLIP_RIGHT_2 (DOOM_CLIP_LEFT_2 + 40)
+
 // Binary Angles, sine/cosine/atan lookups.
 #include "tables.h"
 
