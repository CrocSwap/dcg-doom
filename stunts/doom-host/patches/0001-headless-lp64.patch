+
+int main(int argc, char **argv) {
+  char *iwad=arg_after(argc,argv,"-iwad"), *demo_name=arg_after(argc,argv,"-demo"), *frames=arg_after(argc,argv,"-frames"), *flip=arg_after(argc,argv,"--flip-forwardmove-tic");
+  byte *demo; int demo_len, flip_tic=-1, tic; FILE *out; uint8_t wad_hash[32], strip[STRIP_BYTES]; char digest[65]; double tic_ms=0.0, render_ms=0.0; int rendered=0;
+  if(!has_arg(argc,argv,"-headless")||!iwad||!frames){usage(argv[0]);return 2;} if(!demo_name)demo_name="DEMO1"; if(flip){char *end=0;long v=strtol(flip,&end,10);if(!end||*end||v<0||v>1000000){fprintf(stderr,"bad --flip-forwardmove-tic\n");return 2;}flip_tic=(int)v;}
+  if(hash_file(iwad,wad_hash)){fprintf(stderr,"cannot hash %s: %s\n",iwad,strerror(errno));return 2;}
+  myargc=argc;myargv=argv;gamemode=shareware;gamemission=doom;language=english;deathmatch=0;consoleplayer=0;displayplayer=0;
+  Z_Init(); W_InitFile(iwad); V_Init(); R_Init(); R_ExecuteSetViewSize(); P_Init();
+  demo_len=W_LumpLength(W_GetNumForName(demo_name)); demo=W_CacheLumpName(demo_name,PU_STATIC); if(demo_len<14){fprintf(stderr,"demo too short\n");return 2;}
+  defdemoname=demo_name;demobuffer=demo;demo_p=demo;doom_headless_demo_done=false;G_DoPlayDemo();
+  /* G_DoPlayDemo consumes the 13-byte header.  Mutate the forwardmove
+     command at the requested stream tic, not the immutable WAD file. */
+  if(flip_tic>=0){long off=(long)flip_tic*4L;if(off<0||off+4>demo_len-(demo_p-demobuffer)){fprintf(stderr,"flip tic outside one-player demo\n");return 2;}demo_p[off]^=1;}
+  out=fopen(frames,"w");if(!out){fprintf(stderr,"cannot open %s: %s\n",frames,strerror(errno));return 2;}
+  for(tic=0;!doom_headless_demo_done && tic<100000;tic++) { int strip_id,x,y;double started=now_ms(),render_started;
+    G_Ticker(); if (doom_headless_demo_done) break; render_started=now_ms(); R_RenderPlayerView(&players[displayplayer]); render_ms+=now_ms()-render_started;
+    for(strip_id=0;strip_id<STRIPS;strip_id++){for(x=0;x<STRIP_WIDTH;x++)for(y=0;y<FB_HEIGHT;y++)strip[x*FB_HEIGHT+y]=screens[0][y*FB_WIDTH+strip_id*STRIP_WIDTH+x];hash_record("DOOM-FB1",wad_hash,(uint32_t)gametic,(uint32_t)strip_id,strip,sizeof(strip),digest);fprintf(out,"{\"gametic\":%u,\"strip_id\":%d,\"sha256\":\"%s\"}\n",(unsigned)gametic,strip_id,digest);}
+    hash_record("DOOM-FB1-FRAME",wad_hash,(uint32_t)gametic,0,screens[0],FB_WIDTH*FB_HEIGHT,digest);fprintf(out,"{\"gametic\":%u,\"strip_id\":-1,\"sha256\":\"%s\"}\n",(unsigned)gametic,digest);
+    tic_ms+=now_ms()-started; rendered++; gametic++;
+  }
+  fclose(out); if(tic==100000){fprintf(stderr,"demo did not terminate\n");return 1;} fprintf(stderr,"doom-headless: tics=%d ms/tic=%.6f ms/render=%.6f\n",rendered,tic_ms/rendered,render_ms/rendered); return 0;
+}
