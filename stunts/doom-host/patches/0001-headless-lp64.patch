diff --git a/linuxdoom-1.10/headless/Makefile b/linuxdoom-1.10/headless/Makefile
new file mode 100644
index 0000000..62e85b3
--- /dev/null
+++ b/linuxdoom-1.10/headless/Makefile
@@ -0,0 +1,38 @@
+CC ?= cc
+
+# The original X11 front end and sound server are deliberately not linked.
+# Use ordinary host optimisation; sanitizer runs override CFLAGS explicitly.
+CFLAGS ?= -O2 -g -std=gnu89 -DNORMALUNIX -DHEADLESS_DOOM -Wno-deprecated-non-prototype -Wno-implicit-int -Wno-int-conversion -Wno-incompatible-pointer-types -Wno-format-security
+CPPFLAGS ?= -I..
+LDFLAGS ?=
+LDLIBS ?= -lm
+
+OUT ?= ../doom-headless
+OBJS = $(patsubst ../%.c,%.o,$(SOURCES)) doom_headless.o doom_stubs.o
+SOURCES = \
+ ../doomdef.c ../doomstat.c ../dstrings.c ../d_items.c ../g_game.c \
+ ../m_argv.c ../m_bbox.c ../m_fixed.c ../m_random.c ../m_swap.c \
+ ../tables.c ../info.c ../z_zone.c ../w_wad.c ../v_video.c \
+ ../p_ceilng.c ../p_doors.c ../p_enemy.c ../p_floor.c ../p_inter.c \
+ ../p_lights.c ../p_map.c ../p_maputl.c ../p_mobj.c ../p_plats.c \
+ ../p_pspr.c ../p_setup.c ../p_sight.c ../p_spec.c ../p_switch.c \
+ ../p_telept.c ../p_tick.c ../p_user.c \
+ ../r_bsp.c ../r_data.c ../r_draw.c ../r_main.c ../r_plane.c ../r_segs.c \
+ ../r_sky.c ../r_things.c
+
+all: $(OUT)
+
+$(OUT): $(OBJS)
+	$(CC) $(LDFLAGS) -o $@ $(OBJS) $(LDLIBS)
+
+%.o: ../%.c
+	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@
+
+doom_headless.o: doom_headless.c
+	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@
+
+doom_stubs.o: doom_stubs.c
+	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@
+
+clean:
+	rm -f $(OBJS) $(OUT)
