+//
+// W_InitAccountImage
+// The account adapter has already checked the root and chunk manifest.  This
+// function only parses the little-endian WAD directory and binds every lump
+// to an offset in the immutable concatenated image.
+//
+void W_InitAccountImage (const byte* image, int image_bytes)
+{
+    wadinfo_t header;
+    filelump_t fileinfo;
+    lumpinfo_t* lump_p;
+    int i;
+    int directory_bytes;
+
+    if (!image || image_bytes < (int)sizeof(header))
+	I_Error ("W_InitAccountImage: short image");
+    memcpy (&header, image, sizeof(header));
+    header.numlumps = LONG(header.numlumps);
+    header.infotableofs = LONG(header.infotableofs);
+    if (header.numlumps < 0 || header.infotableofs < (int)sizeof(header))
+	I_Error ("W_InitAccountImage: bad directory");
+    if (header.numlumps > (image_bytes - header.infotableofs) / (int)sizeof(filelump_t))
+	I_Error ("W_InitAccountImage: directory overflow");
+    directory_bytes = header.numlumps * (int)sizeof(filelump_t);
+    if (header.infotableofs > image_bytes || directory_bytes > image_bytes - header.infotableofs)
+	I_Error ("W_InitAccountImage: directory outside image");
+
+    doom_account_wad = image;
+    doom_account_wad_bytes = image_bytes;
+    numlumps = header.numlumps;
+    lumpinfo = malloc (numlumps * sizeof(*lumpinfo));
+    lumpcache = calloc (numlumps, sizeof(*lumpcache));
+    if ((numlumps && !lumpinfo) || (numlumps && !lumpcache))
+	I_Error ("W_InitAccountImage: out of memory");
+    for (i=0, lump_p=lumpinfo; i<numlumps; i++, lump_p++)
+    {
+	memcpy (&fileinfo, image + header.infotableofs + i*sizeof(filelump_t),
+		 sizeof(fileinfo));
+	lump_p->handle = -2; /* account image */
+	lump_p->position = LONG(fileinfo.filepos);
+	lump_p->size = LONG(fileinfo.size);
+	memcpy (lump_p->name, fileinfo.name, sizeof(lump_p->name));
+	if (lump_p->position < 0 || lump_p->size < 0
+	    || lump_p->position > image_bytes
+	    || lump_p->size > image_bytes - lump_p->position)
+	    I_Error ("W_InitAccountImage: lump %i outside image", i);
+    }
+}
+
