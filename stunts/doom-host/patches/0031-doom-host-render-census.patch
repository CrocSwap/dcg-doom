diff --git a/linuxdoom-1.10/r_main.c b/linuxdoom-1.10/r_main.c
--- a/linuxdoom-1.10/r_main.c
+++ b/linuxdoom-1.10/r_main.c
@@ -40,6 +40,106 @@
 
 #include "r_local.h"
 #include "r_sky.h"
+
+#ifdef DOOM_HOST_RENDER_CENSUS
+#define DOOM_HOST_CENSUS_VALUES 56
+static long long doom_host_census_values[DOOM_HOST_CENSUS_VALUES];
+static unsigned char doom_host_census_rows[200];
+static unsigned long doom_host_census_current_phase;
+
+void doom_host_render_census_reset(void)
+{
+    int i;
+    for (i = 0; i < DOOM_HOST_CENSUS_VALUES; ++i)
+        doom_host_census_values[i] = 0;
+    for (i = 0; i < 200; ++i)
+        doom_host_census_rows[i] = 0;
+    doom_host_census_current_phase = 0;
+}
+
+void doom_host_render_census_values(long long *out)
+{
+    int i;
+    unsigned long rows = 0;
+    for (i = 0; i < DOOM_HOST_CENSUS_VALUES; ++i)
+        out[i] = doom_host_census_values[i];
+    for (i = 0; i < 200; ++i)
+        rows += doom_host_census_rows[i] != 0;
+    out[4] = (long long)rows;
+}
+
+void doom_host_render_census_phase(unsigned long phase)
+{
+    doom_host_census_current_phase = phase;
+}
+
+void doom_host_render_census_column(unsigned long pixels, unsigned long columns, int x)
+{
+    int strip = x / 40;
+    if (strip < 0) strip = 0;
+    if (strip > 7) strip = 7;
+    if (doom_host_census_current_phase == 1)
+    {
+        doom_host_census_values[0] += pixels;
+        doom_host_census_values[1] += columns;
+        doom_host_census_values[16 + strip] += pixels;
+    }
+    else if (doom_host_census_current_phase == 4)
+    {
+        doom_host_census_values[5] += pixels;
+        doom_host_census_values[32 + strip] += pixels;
+    }
+    else if (doom_host_census_current_phase == 3 || doom_host_census_current_phase == 5)
+    {
+        doom_host_census_values[6] += pixels;
+        doom_host_census_values[40 + strip] += pixels;
+        if (doom_host_census_current_phase == 5)
+        {
+            doom_host_census_values[11] += pixels;
+            doom_host_census_values[48 + strip] += pixels;
+        }
+    }
+}
+
+void doom_host_render_census_span(unsigned long pixels, int row, int x1, int x2)
+{
+    int x;
+    doom_host_census_values[2] += pixels;
+    doom_host_census_values[3] += 1;
+    if (row >= 0 && row < 200)
+        doom_host_census_rows[row] = 1;
+    for (x = x1; x <= x2; ++x)
+    {
+        int strip = x / 40;
+        if (strip >= 0 && strip < 8)
+            doom_host_census_values[24 + strip] += 1;
+    }
+}
+
+void doom_host_render_census_scene(unsigned long drawseg_count, unsigned long visplane_count)
+{
+    doom_host_census_values[8] = drawseg_count;
+    doom_host_census_values[10] = visplane_count;
+}
+
+void doom_host_render_census_sprite(void)
+{
+    doom_host_census_values[7] += 1;
+}
+
+void doom_host_render_census_clip_step(void)
+{
+    doom_host_census_values[9] += 1;
+}
+
+void doom_host_render_census_view(int x, int y, unsigned long angle, unsigned long floorpic)
+{
+    doom_host_census_values[12] = x;
+    doom_host_census_values[13] = y;
+    doom_host_census_values[14] = (long long)angle;
+    doom_host_census_values[15] = (long long)floorpic;
+}
+#endif
 
 
 
