diff --git a/linuxdoom-1.10/headless/doom_controller.h b/linuxdoom-1.10/headless/doom_controller.h
new file mode 100644
index 0000000..f27ef15
--- /dev/null
+++ b/linuxdoom-1.10/headless/doom_controller.h
@@ -0,0 +1,11 @@
+#ifndef DOOM_CONTROLLER_H
+#define DOOM_CONTROLLER_H
+
+#include <stdint.h>
+
+/* DOOM-CI1 v1: the four bytes are the captured ticcmd at byte 24. */
+#define DOOM_CONTROLLER_BYTES 64
+
+int DoomControllerRead(const char *, uint32_t, uint8_t[4]);
+
+#endif
diff --git a/linuxdoom-1.10/headless/doom_controller.c b/linuxdoom-1.10/headless/doom_controller.c
new file mode 100644
index 0000000..df3546d
--- /dev/null
+++ b/linuxdoom-1.10/headless/doom_controller.c
@@ -0,0 +1,33 @@
+/* Minimal host adapter for one captured DOOM-CI1 command. */
+#include <stdio.h>
+#include <stdint.h>
+#include <string.h>
+#include "doom_controller.h"
+
+static uint32_t u32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8)
+        | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+int DoomControllerRead(const char *path, uint32_t expected_gametic, uint8_t out[4])
+{
+    FILE *f;
+    uint8_t b[DOOM_CONTROLLER_BYTES];
+    int extra;
+    if (!path || !out || !(f = fopen(path, "rb")))
+        return -1;
+    if (fread(b, 1, sizeof(b), f) != sizeof(b)) {
+        fclose(f);
+        return -1;
+    }
+    extra = fgetc(f);
+    fclose(f);
+    if (extra != EOF || memcmp(b, "DOOM-CI1", 8)
+        || u32(b + 8) != 1 || u32(b + 12) != 28
+        || u32(b + 16) != DOOM_CONTROLLER_BYTES || u32(b + 20) != expected_gametic
+        || b[28] || memcmp(b + 29, b + 28, sizeof(b) - 29))
+        return -1;
+    memcpy(out, b + 24, 4);
+    return 0;
+}
