-OBJS = $(patsubst ../%.c,%.o,$(SOURCES)) doom_headless.o doom_state.o doom_account.o doom_render.o doom_stubs.o doom_ctx_init.o
+OBJS = $(patsubst ../%.c,%.o,$(SOURCES)) doom_headless.o doom_state.o doom_account.o doom_render.o doom_controller.o doom_stubs.o doom_ctx_init.o
 SOURCES = \
  ../doomdef.c ../doomstat.c ../dstrings.c ../d_items.c ../g_game.c \
