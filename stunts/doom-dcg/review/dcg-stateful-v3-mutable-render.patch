diff --git a/crates/dcg-program/src/kernel.rs b/crates/dcg-program/src/kernel.rs
index 6b0dc8d..30b40a7 100644
--- a/crates/dcg-program/src/kernel.rs
+++ b/crates/dcg-program/src/kernel.rs
@@ -502,6 +502,45 @@ pub trait StatefulKernel: Kernel {
         self.render_view_phase(phase, state, output)
     }
 
+    /// Opt in to writable state accounts while rendering. This is intended
+    /// for application renderers whose engine ABI uses state-backed scratch
+    /// fields at a fixed address. The callback receives mutable spans and is
+    /// responsible for preserving its consensus state; the default view path
+    /// remains read-only.
+    fn view_requires_mutable_state(&self) -> bool {
+        false
+    }
+
+    /// Render with mutable state spans for applications that explicitly opt
+    /// in through `view_requires_mutable_state`. The default adapter exposes
+    /// those bytes as read-only spans and calls the existing resource-aware
+    /// view hook.
+    fn render_view_phase_with_mutable_state(
+        &self,
+        phase: ViewPhase,
+        state: &mut [StateSpanMut<'_>],
+        resources: &[AccountSpan<'_>],
+        commitment: &[u8; 32],
+        workspace: &mut [u8],
+        output: &mut [u8],
+    ) -> Result<usize, KernelError> {
+        let readonly: Vec<AccountSpan<'_>> = state
+            .iter()
+            .map(|span| AccountSpan {
+                key: span.key,
+                owner: span.owner,
+                is_signer: false,
+                is_writable: true,
+                schema: span.schema,
+                offset: span.offset,
+                data: span.data,
+            })
+            .collect();
+        self.render_view_phase_with_resources(
+            phase, &readonly, resources, commitment, workspace, output,
+        )
+    }
+
     /// The output ABIs this application image permits for state views.
     /// Unknown ABI ids are refused when a view account is declared.
