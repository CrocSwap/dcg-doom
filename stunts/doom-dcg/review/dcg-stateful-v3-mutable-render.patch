 }
 
+fn render_phase_chunk(
+    state_metas: &[StateSpanMeta],
+    state_accounts: &[AccountInfo],
+    primary_state: bool,
+    view_metas: &[ViewMeta],
+    resources: &[AccountSpan<'_>],
+    commitment: &[u8; 32],
+    workspace: &mut [u8],
+    chunk_start: u32,
+    chunk: &mut [u8],
+    state_cursor: u32,
+    compute_units: u32,
+    kernel: &dyn StatefulKernel,
+) -> ProgramResult {
+    if kernel.view_requires_mutable_state() {
+        let mut guards = state_accounts
+            .iter()
+            .map(AccountInfo::try_borrow_mut_data)
+            .collect::<Result<Vec<_>, _>>()?;
+        let mut state: Vec<StateSpanMut<'_>> = state_accounts
+            .iter()
+            .zip(guards.iter_mut())
+            .zip(state_metas.iter())
+            .enumerate()
+            .map(|(index, ((account, raw), meta))| StateSpanMut {
+                key: account.key.to_bytes(),
+                owner: account.owner.to_bytes(),
+                schema: meta.schema,
+                offset: meta.offset,
+                data: if primary_state && index == 0 {
+                    &mut raw[..meta.len as usize]
+                } else {
+                    &mut raw[CHILD_HEADER_BYTES..CHILD_HEADER_BYTES + meta.len as usize]
+                },
+            })
+            .collect();
+        let bind = kernel.bind_invocation_state(&mut state);
+        let result = if bind.is_ok() {
+            render_view_outputs(
+                view_metas,
+                chunk_start,
+                chunk,
+                state_cursor,
+                compute_units,
+                |request, output| {
+                    kernel.render_view_phase_with_mutable_state(
+                        request, &mut state, resources, commitment, workspace, output,
+                    )
+                },
+            )
+        } else {
+            Err(refusal(REFUSAL_KERNEL))
+        };
+        kernel.unbind_invocation_state();
+        result
+    } else {
+        let guards = state_accounts
+            .iter()
+            .map(AccountInfo::try_borrow_data)
+            .collect::<Result<Vec<_>, _>>()?;
+        let state: Vec<AccountSpan<'_>> = state_accounts
+            .iter()
+            .zip(guards.iter())
+            .zip(state_metas.iter())
+            .enumerate()
+            .map(|(index, ((account, raw), meta))| AccountSpan {
+                key: account.key.to_bytes(),
+                owner: account.owner.to_bytes(),
+                is_signer: account.is_signer,
+                is_writable: account.is_writable,
+                schema: meta.schema,
+                offset: meta.offset,
+                data: if primary_state && index == 0 {
+                    &raw[..meta.len as usize]
+                } else {
+                    &raw[CHILD_HEADER_BYTES..CHILD_HEADER_BYTES + meta.len as usize]
+                },
+            })
+            .collect();
+        render_view_outputs(
+            view_metas,
+            chunk_start,
+            chunk,
+            state_cursor,
+            compute_units,
+            |request, output| {
+                kernel.render_view_phase_with_resources(
+                    request, &state, resources, commitment, workspace, output,
+                )
+            },
+        )
+    }
+}
