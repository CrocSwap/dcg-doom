-        .collect();
     let chunk_end = chunk_start
         .checked_add(chunk.len() as u32)
         .ok_or_else(|| refusal(REFUSAL_VIEW))?;
@@ -2976,15 +2947,7 @@ fn render_phase_chunk(
                 output_offset: local,
