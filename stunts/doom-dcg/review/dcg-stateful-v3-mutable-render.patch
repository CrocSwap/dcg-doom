+    struct MutableViewCompatibilityProbe {
+        called: AtomicBool,
+    }
+
+    static MUTABLE_VIEW_MODES: [ModeId; 1] = [ModeId { id: 1, version: 1 }];
+    static MUTABLE_VIEW_MANIFEST: KernelManifest = KernelManifest {
+        id: KernelId([0xB8; 16]),
+        semantic_version: 1,
+        abi_version: 1,
+        input: PortLayout {
+            id: VersionedId { id: 1, version: 1 },
+            max_bytes: 1,
+            alignment: 1,
+        },
+        output: PortLayout {
+            id: VersionedId { id: 2, version: 1 },
+            max_bytes: 3,
+            alignment: 1,
+        },
+        state: Some(StateSchema {
+            id: VersionedId { id: 3, version: 1 },
+            max_bytes: 3,
+        }),
+        resources: ResourceLimits {
+            max_input_bytes: 1,
+            max_output_bytes: 3,
+            max_state_bytes: 3,
+            max_operations: 1,
+            max_compute_units: 1,
+        },
+        modes: &MUTABLE_VIEW_MODES,
+    };
+
+    impl Kernel for MutableViewCompatibilityProbe {
+        fn manifest(&self) -> &'static KernelManifest {
+            &MUTABLE_VIEW_MANIFEST
+        }
+
+        fn execute(&self, _input: &[u8], _output: &mut [u8]) -> Result<usize, KernelError> {
+            Err(KernelError::Refused)
+        }
+    }
+
+    impl StatefulKernel for MutableViewCompatibilityProbe {
+        fn initial_state(&self, _output: &mut [u8]) -> Result<usize, KernelError> {
+            Err(KernelError::Refused)
+        }
+
+        fn transition(
+            &self,
+            _input: &[u8],
+            _prior_state: &[u8],
+            _output: &mut [u8],
+            _next_state: &mut [u8],
+        ) -> Result<(usize, usize), KernelError> {
+            Err(KernelError::Refused)
+        }
+
+        fn render_view_phase_with_resources(
+            &self,
+            _phase: ViewPhase,
+            state: &[AccountSpan<'_>],
+            resources: &[AccountSpan<'_>],
+            commitment: &[u8; 32],
+            workspace: &mut [u8],
+            output: &mut [u8],
+        ) -> Result<usize, KernelError> {
+            if state.len() != 1
+                || !state[0].is_writable
+                || !resources.is_empty()
+                || *commitment != [0; 32]
+                || !workspace.is_empty()
+                || output.len() != state[0].data.len()
+            {
+                return Err(KernelError::InvalidInput);
+            }
+            output.copy_from_slice(state[0].data);
+            self.called.store(true, Ordering::Relaxed);
+            Ok(output.len())
+        }
+    }
+
+    #[test]
+    fn mutable_state_view_default_preserves_resource_aware_adapter() {
+        let kernel = MutableViewCompatibilityProbe {
+            called: AtomicBool::new(false),
+        };
+        assert!(!kernel.view_requires_mutable_state());
+        let schema = VersionedId { id: 3, version: 1 };
+        let mut bytes = [7u8, 11, 13];
+        let mut spans = [StateSpanMut {
+            key: [1; 32],
+            owner: [2; 32],
+            schema,
+            offset: 0,
+            data: &mut bytes,
+        }];
+        let phase = ViewPhase {
+            state_cursor: 0,
+            role: 0,
+            source_offset: 0,
+            output_offset: 0,
+            compute_units: 1,
+        };
+        let mut output = [0u8; 3];
+        assert_eq!(
+            kernel.render_view_phase_with_mutable_state(
+                phase,
+                &mut spans,
+                &[],
+                &[0; 32],
+                &mut [],
+                &mut output,
+            ),
+            Ok(3)
+        );
+        assert!(kernel.called.load(Ordering::Relaxed));
+        assert_eq!(output, bytes);
+    }
+
